NEO4J_PASSWORD=replace-with-a-long-local-password
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_DATABASE=neo4j
# Public port when running the Compose command-center stack.
FUSION_PORT=8080
# Multi-platform social layer (all keyless). Comma-separated subset of
# telegram,reddit,bluesky,mastodon. Targets per platform are also overridable.
#SOCIAL_PLATFORMS=telegram,reddit,bluesky,mastodon
#SOCIAL_REDDIT_SUBS=worldnews,geopolitics,CombatFootage,UkraineWarVideoReport
#SOCIAL_BLUESKY_QUERIES=Strait of Hormuz,tanker,Hormuz,IRGC
#SOCIAL_MASTODON_INSTANCES=mastodon.social
