NEO4J_PASSWORD=replace-with-a-long-local-password
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_DATABASE=neo4j
# Public port when running the Compose command-center stack.
FUSION_PORT=8080

# Live AIS vessels within saved AOIs (server-side credential).
AISSTREAM_API_KEY=

# OpenAI Responses API. Leave blank until an application API key is available.
OPENAI_API_KEY=
FUSION_OPENAI_MODEL=gpt-5.4-mini
# Automatic analysis every 3 minutes, prioritizing source evidence over proximity.
FUSION_LLM_EVERY_S=180
# Revisit an unchanged report/asset pair after 30 minutes. Manual analysis bypasses this.
FUSION_LLM_REPEAT_S=1800
# At most two proximity-only pairs per batch.
FUSION_LLM_PROXIMITY_LIMIT=2
# Maximum automatic adjudications per pass. Click-two analysis is not capped.
FUSION_LLM_MAX_CANDIDATES=12
# On-demand AOI summaries include all available records in the circle.
FUSION_AOI_SUMMARY_TIMEOUT_S=180
# GDELT source articles are fetched only when a record reaches adjudication.
FUSION_SOURCE_DOC_MAX_CHARS=24000
FUSION_SOURCE_DOC_TIMEOUT_S=12
FUSION_SOURCE_DOC_MAX_BYTES=2000000
# Multi-platform social layer (all keyless). Comma-separated subset of
# telegram,reddit,bluesky,mastodon. Targets per platform are also overridable.
#SOCIAL_PLATFORMS=telegram,reddit,bluesky,mastodon
#SOCIAL_REDDIT_SUBS=worldnews,geopolitics,CombatFootage,UkraineWarVideoReport
#SOCIAL_BLUESKY_QUERIES=Strait of Hormuz,tanker,Hormuz,IRGC
#SOCIAL_MASTODON_INSTANCES=mastodon.social
